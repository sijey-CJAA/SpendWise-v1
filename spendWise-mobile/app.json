{
  "expo": {
    "name": "spendWise-mobile",
    "slug": "spendwise-mobile",
    "scheme": "spendwise-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {},
    "icon": "./assets/applogo.svg",
    "splash": {
      "image": "./assets/applogo.svg",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker"
    ]
  }
}
